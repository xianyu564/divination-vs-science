---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
        
  <!-- Main hub pages -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/xuanxue-vs-science/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-CN"
      href="{{ site.url }}{{ site.baseurl }}/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-TW"
      href="{{ site.url }}{{ site.baseurl }}/zh-tw/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="en"
      href="{{ site.url }}{{ site.baseurl }}/en/xuanxue-vs-science/"/>
  </url>
  
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/zh-tw/xuanxue-vs-science/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-CN"
      href="{{ site.url }}{{ site.baseurl }}/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-TW"
      href="{{ site.url }}{{ site.baseurl }}/zh-tw/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="en"
      href="{{ site.url }}{{ site.baseurl }}/en/xuanxue-vs-science/"/>
  </url>
  
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/en/xuanxue-vs-science/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-CN"
      href="{{ site.url }}{{ site.baseurl }}/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="zh-TW"
      href="{{ site.url }}{{ site.baseurl }}/zh-tw/xuanxue-vs-science/"/>
    <xhtml:link 
      rel="alternate"
      hreflang="en"
      href="{{ site.url }}{{ site.baseurl }}/en/xuanxue-vs-science/"/>
  </url>

  <!-- FAQ pages -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/faq/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Glossary pages -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/glossary/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Repository root -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- All pages -->
  {% for page in site.pages %}
    {% unless page.url contains '/404' or page.url contains '/assets/' or page.url contains '/_' %}
      <url>
        <loc>{{ site.url }}{{ site.baseurl }}{{ page.url }}</loc>
        {% if page.date %}
          <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
        {% else %}
          <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        {% endif %}
        <changefreq>{% if page.url contains '/faq/' or page.url contains '/glossary/' %}monthly{% else %}weekly{% endif %}</changefreq>
        <priority>{% if page.url == '/xuanxue-vs-science/' or page.url contains '/xuanxue-vs-science/' %}1.0{% elsif page.url contains '/faq/' or page.url contains '/glossary/' %}0.9{% else %}0.7{% endif %}</priority>
      </url>
    {% endunless %}
  {% endfor %}

  <!-- Posts if any -->
  {% for post in site.posts %}
    <url>
      <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      <changefreq>yearly</changefreq>
      <priority>0.6</priority>
    </url>
  {% endfor %}

  <!-- Collections -->
  {% for collection in site.collections %}
    {% for item in collection.docs %}
      <url>
        <loc>{{ site.url }}{{ site.baseurl }}{{ item.url }}</loc>
        {% if item.date %}
          <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
        {% else %}
          <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        {% endif %}
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
      </url>
    {% endfor %}
  {% endfor %}

</urlset>